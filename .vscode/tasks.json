{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "htable-test: build",
            "type": "shell",
            "command": "make",
            "args": ["htable-test"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "swar_test: build",
            "type": "shell",
            "command": "make",
            "args": ["swar-test"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "kmod: build",
            "type": "shell",
            "command": "make",
            "args": ["all"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "kmod: clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "problemMatcher": []
        },
        {
            "label": "kmod: insert (insmod)",
            "type": "shell",
            "command": "make",
            "args": ["insert"],
            "dependsOn": "kmod: build",
            "problemMatcher": []
        },
        {
            "label": "kmod: remove (rmmod)",
            "type": "shell",
            "command": "make",
            "args": ["remove"],
            "problemMatcher": []
        },
        {
            "label": "kmod: show dmesg log",
            "type": "shell",
            "command": "make",
            "args": ["log"],
            "problemMatcher": []
        },
        {
            "label": "kmod: rebuild and reload",
            "type": "shell",
            "command": "make clean && make all && (sudo rmmod htable 2>/dev/null; sudo insmod htable.ko)",
            "problemMatcher": ["$gcc"]
        }
    ]
}
